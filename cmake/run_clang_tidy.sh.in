#!/usr/bin/env bash
# Generated by CMake — do not edit manually. Source: cmake/run_clang_tidy.sh.in
set -eou pipefail

gcxx_tidy_args=()
if test -n "${GCXX_CLANG_TIDY_ARGS:+x}"; then
    mapfile -t gcxx_tidy_args < <(echo "${GCXX_CLANG_TIDY_ARGS}" | tr ' ' '\n' | sort -u)
fi

set -x

# Use an empty compilation database so clang-tidy does not fall back to the
# project's nvcc compile_commands.json (which contains flags clang cannot parse).
# All compiler flags (includes, defines, language) are passed explicitly by the
# cmake target via the arguments forwarded through "$@".
"@GCXX_CLANG_TIDY@" \
  --use-color \
  --quiet \
  -p '@CMAKE_BINARY_DIR@/tidy_db' \
  "${gcxx_tidy_args[@]}" \
  "$@"
