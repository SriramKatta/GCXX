  "buildPresets": [
    {
      "name": "build_base",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "build_tidy_base",
      "hidden": true,
      "inherits": "build_base",
      "targets": [
        "gcxx.tidy"
      ]
    },

    {
      "name": "build_release_cuda_examples",
