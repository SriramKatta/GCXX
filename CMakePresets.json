    {
      "name": "release_cuda_full",
      "displayName": "CUDA Release (Full Build)",
      "inherits": [
        "mode_cuda",
        "env_cuda_release",
        "purpose_full"
      ]
    },
    {
      "name": "debug_cuda_full",
