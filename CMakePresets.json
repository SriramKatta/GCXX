{
  "version": 7,
  "configurePresets": [
    {
      "name": "base_configure",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CPM_SOURCE_CACHE": "$env{HOME}/.cache/CPM"
      }
    },
    {
      "name": "mode_cuda",
      "hidden": true,
      "inherits": "base_configure",
      "cacheVariables": {
        "GCXX_CUDA_MODE": "ON"
      }
    },
    {
      "name": "mode_hip",
      "hidden": true,
      "inherits": "base_configure",
      "cacheVariables": {
        "GCXX_HIP_MODE": "ON"
      }
    },
    {
      "name": "purpose_examples",
      "hidden": true,
      "cacheVariables": {
        "GCXX_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "purpose_tests",
      "hidden": true,
      "cacheVariables": {
        "GCXX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "purpose_benchmarks",
      "hidden": true,
      "cacheVariables": {
        "GCXX_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "purpose_full",
      "hidden": true,
      "inherits": [
        "purpose_examples",
        "purpose_tests",
        "purpose_benchmarks"
      ]
    },
    {
      "name": "config_debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GCXX_ENABLE_RUNTIME_CHECKS": "ON"
      }
    },
    {
      "name": "config_release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "config_tidy",
      "hidden": true,
      "cacheVariables": {
        "GCXX_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "env_cuda_release",
      "hidden": true,
      "inherits": "config_release",
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-release",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/cudabin-release"
      }
    },
    {
      "name": "env_cuda_debug",
      "hidden": true,
      "inherits": "config_debug",
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-debug",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/cudabin-debug"
      }
    },
    {
      "name": "env_hip_release",
      "hidden": true,
      "inherits": "config_release",
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-release",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/hipbin-release"
      }
    },
    {
      "name": "env_hip_debug",
      "hidden": true,
      "inherits": "config_debug",
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-debug",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/hipbin-debug"
      }
    },

    {
      "name": "release_cuda_examples",
      "displayName": "CUDA Release (Examples)",
      "inherits": [
        "mode_cuda",
        "env_cuda_release",
        "purpose_examples"
      ]
    },
    {
      "name": "debug_cuda_examples",
