{
  "version": 7,
  "configurePresets": [
    {
      "name": "base_configure",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CPM_SOURCE_CACHE": "$env{HOME}/.cache/CPM"
      }
    },
    {
      "name": "base_release",
      "hidden": true,
      "inherits": "base_configure",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base_debug",
      "hidden": true,
      "inherits": "base_configure",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mode_cuda",
      "hidden": true,
      "cacheVariables": {
        "GCXX_CUDA_MODE": "ON"
      }
    },
    {
      "name": "mode_hip",
      "hidden": true,
      "cacheVariables": {
        "GCXX_HIP_MODE": "ON"
      }
    },
    {
      "name": "purpose_examples",
      "hidden": true,
      "cacheVariables": {
        "GCXX_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "purpose_tests",
      "hidden": true,
      "cacheVariables": {
        "GCXX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "purpose_full",
      "hidden": true,
      "cacheVariables": {
        "GCXX_BUILD_EXAMPLES": "ON",
        "GCXX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release_cuda_examples",
      "displayName": "CUDA Release (Examples)",
      "inherits": [
        "base_release",
        "mode_cuda",
        "purpose_examples"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-release",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/cudabin-release"
      }
    },
    {
      "name": "debug_cuda_examples",
      "displayName": "CUDA Debug (Examples)",
      "inherits": [
        "base_debug",
        "mode_cuda",
        "purpose_examples"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-debug",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/cudabin-debug"
      }
    },
    {
      "name": "release_cuda_tests",
      "displayName": "CUDA Release (Tests)",
      "inherits": [
        "base_release",
        "mode_cuda",
        "purpose_tests"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-release"
    },
    {
      "name": "debug_cuda_tests",
      "displayName": "CUDA Debug (Tests)",
      "inherits": [
        "base_debug",
        "mode_cuda",
        "purpose_tests"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-debug"
    },
    {
      "name": "release_hip_examples",
      "displayName": "HIP Release (Examples)",
      "inherits": [
        "base_release",
        "mode_hip",
        "purpose_examples"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-release",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/hipbin-release"
      }
    },
    {
      "name": "debug_hip_examples",
      "displayName": "HIP Debug (Examples)",
      "inherits": [
        "base_debug",
        "mode_hip",
        "purpose_examples"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-debug",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/hipbin-debug"
      }
    },
    {
      "name": "release_hip_tests",
      "displayName": "HIP Release (Tests)",
      "inherits": [
        "base_release",
        "mode_hip",
        "purpose_tests"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-release"
    },
    {
      "name": "debug_hip_tests",
      "displayName": "HIP Debug (Tests)",
      "inherits": [
        "base_debug",
        "mode_hip",
        "purpose_tests"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-debug"
    },
    {
      "name": "release_cuda_full",
      "displayName": "CUDA Release (Full Build)",
      "inherits": [
        "base_release",
        "mode_cuda",
        "purpose_full"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-release",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/cudabin-release"
      }
    },
    {
      "name": "debug_cuda_full",
      "displayName": "CUDA Debug (Full Build)",
      "inherits": [
        "base_debug",
        "mode_cuda",
        "purpose_full"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/cuda-debug",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/cudabin-debug",
        "GCXX_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "release_hip_full",
      "displayName": "HIP Release (Full Build)",
      "inherits": [
        "base_release",
        "mode_hip",
        "purpose_full"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-release",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/hipbin-release"
      }
    },
    {
      "name": "debug_hip_full",
      "displayName": "HIP Debug (Full Build)",
      "inherits": [
        "base_debug",
        "mode_hip",
        "purpose_full"
      ],
      "binaryDir": "${sourceDir}/build/$env{CONTAINER_NAME}/hip-debug",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY":
          "${sourceDir}/build/$env{CONTAINER_NAME}/hipbin-debug",
        "GCXX_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build_base",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "build_release_cuda_examples",
      "displayName": "Build CUDA Release (Examples)",
      "configurePreset": "release_cuda_examples",
      "inherits": "build_base"
    },
    {
      "name": "build_debug_cuda_examples",
      "displayName": "Build CUDA Debug (Examples)",
      "configurePreset": "debug_cuda_examples",
      "inherits": "build_base"
    },
    {
      "name": "build_release_hip_examples",
      "displayName": "Build HIP Release (Examples)",
      "configurePreset": "release_hip_examples",
      "inherits": "build_base"
    },
    {
      "name": "build_debug_hip_examples",
      "displayName": "Build HIP Debug (Examples)",
      "configurePreset": "debug_hip_examples",
      "inherits": "build_base"
    },
    {
      "name": "build_release_cuda_tests",
      "displayName": "Build CUDA Release (Tests)",
      "configurePreset": "release_cuda_tests",
      "inherits": "build_base"
    },
    {
      "name": "build_debug_cuda_tests",
      "displayName": "Build CUDA Debug (Tests)",
      "configurePreset": "debug_cuda_tests",
      "inherits": "build_base"
    },
    {
      "name": "build_release_hip_tests",
      "displayName": "Build HIP Release (Tests)",
      "configurePreset": "release_hip_tests",
      "inherits": "build_base"
    },
    {
      "name": "build_debug_hip_tests",
      "displayName": "Build HIP Debug (Tests)",
      "configurePreset": "debug_hip_tests",
      "inherits": "build_base"
    },
    {
      "name": "build_release_cuda_full",
      "displayName": "Build CUDA Release (Full)",
      "configurePreset": "release_cuda_full",
      "inherits": "build_base"
    },
    {
      "name": "build_debug_cuda_full",
      "displayName": "Build CUDA Debug (Full)",
      "configurePreset": "debug_cuda_full",
      "inherits": "build_base"
    },
    {
      "name": "build_release_hip_full",
      "displayName": "Build HIP Release (Full)",
      "configurePreset": "release_hip_full",
      "inherits": "build_base"
    },
    {
      "name": "build_debug_hip_full",
      "displayName": "Build HIP Debug (Full)",
      "configurePreset": "debug_hip_full",
      "inherits": "build_base"
    },
    {
      "name": "build_tidy_cuda",
      "displayName": "clang-tidy (CUDA)",
      "configurePreset": "debug_cuda_full",
      "inherits": "build_base",
      "targets": ["gcxx.tidy"]
    },
    {
      "name": "build_tidy_hip",
      "displayName": "clang-tidy (HIP)",
      "configurePreset": "debug_hip_full",
      "inherits": "build_base",
      "targets": ["gcxx.tidy"]
    }
  ],
  "testPresets": [
    {
      "name": "test_base",
      "hidden": true,
      "environment": {
        "GTEST_COLOR": "1"
      },
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "test_release_cuda",
      "displayName": "Test CUDA Release",
      "inherits": "test_base",
      "configurePreset": "release_cuda_tests"
    },
    {
      "name": "test_debug_cuda",
      "displayName": "Test CUDA Debug",
      "inherits": "test_base",
      "configurePreset": "debug_cuda_tests"
    },
    {
      "name": "test_release_hip",
      "displayName": "Test HIP Release",
      "inherits": "test_base",
      "configurePreset": "release_hip_tests"
    },
    {
      "name": "test_debug_hip",
      "displayName": "Test HIP Debug",
      "inherits": "test_base",
      "configurePreset": "debug_hip_tests"
    }
  ],
  "workflowPresets": [
    {
      "name": "workflow_release_cuda_examples",
      "displayName": "CUDA Release Examples",
      "steps": [
        {
          "type": "configure",
          "name": "release_cuda_examples"
        },
        {
          "type": "build",
          "name": "build_release_cuda_examples"
        }
      ]
    },
    {
      "name": "workflow_debug_cuda_examples",
      "displayName": "CUDA Debug Examples",
      "steps": [
        {
          "type": "configure",
          "name": "debug_cuda_examples"
        },
        {
          "type": "build",
          "name": "build_debug_cuda_examples"
        }
      ]
    },
    {
      "name": "workflow_release_hip_examples",
      "displayName": "HIP Release Examples",
      "steps": [
        {
          "type": "configure",
          "name": "release_hip_examples"
        },
        {
          "type": "build",
          "name": "build_release_hip_examples"
        }
      ]
    },
    {
      "name": "workflow_debug_hip_examples",
      "displayName": "HIP Debug Examples",
      "steps": [
        {
          "type": "configure",
          "name": "debug_hip_examples"
        },
        {
          "type": "build",
          "name": "build_debug_hip_examples"
        }
      ]
    },
    {
