        },
        {
          "type": "build",
          "name": "build_release_cuda_tests"
        },
        {
          "type": "test",
          "name": "test_release_cuda"
        }
      ]
    },
    {
      "name": "workflow_debug_cuda_tests",
      "displayName": "CUDA Debug Tests",
      "steps": [
        {
          "type": "configure",
          "name": "debug_cuda_tests"
        },
        {
          "type": "build",
          "name": "build_debug_cuda_tests"
        },
        {
          "type": "test",
          "name": "test_debug_cuda"
        }
      ]
    },
    {
      "name": "workflow_release_hip_tests",
      "displayName": "HIP Release Tests",
      "steps": [
        {
          "type": "configure",
          "name": "release_hip_tests"
        },
        {
          "type": "build",
          "name": "build_release_hip_tests"
        },
        {
          "type": "test",
          "name": "test_release_hip"
        }
      ]
    },
    {
      "name": "workflow_debug_hip_tests",
      "displayName": "HIP Debug Tests",
      "steps": [
        {
          "type": "configure",
          "name": "debug_hip_tests"
        },
        {
          "type": "build",
          "name": "build_debug_hip_tests"
        },
        {
          "type": "test",
          "name": "test_debug_hip"
        }
      ]
    },
    {
      "name": "workflow_release_cuda_full",
      "displayName": "CUDA Release Full Build",
      "steps": [
        {
          "type": "configure",
          "name": "release_cuda_full"
        },
        {
          "type": "build",
          "name": "build_release_cuda_full"
        }
      ]
    },
    {
      "name": "workflow_debug_cuda_full",
      "displayName": "CUDA Debug Full Build",
      "steps": [
        {
          "type": "configure",
          "name": "debug_cuda_full"
        },
        {
          "type": "build",
          "name": "build_debug_cuda_full"
        }
      ]
