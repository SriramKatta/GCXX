      "displayName": "HIP Debug Full Build",
      "steps": [
        {
          "type": "configure",
          "name": "debug_hip_full"
        },
        {
          "type": "build",
          "name": "build_debug_hip_full"
        }
      ]
    },
    {
      "name": "workflow_tidy_cuda",
      "displayName": "clang-tidy (CUDA)",
      "steps": [
