  "testPresets": [
    {
      "name": "test_base",
      "hidden": true,
      "environment": {
        "GTEST_COLOR": "1"
      },
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "test_release_cuda",
