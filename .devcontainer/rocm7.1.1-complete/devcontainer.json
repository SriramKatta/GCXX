{
  "name": "GCXX ROCm 7.1.1",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".",
    "args": {
      "BASE_IMAGE": "rocm/dev-ubuntu-24.04:7.1.1-complete",
      "GCC_VERSION": "13",
      "CONTAINER_NAME": "gcxx-rocm7.1.1"
    }
  },
  "runArgs": [
    "--init",
    "--name",
    "rocm-7.1.1-devel-gcc13"
  ],
  "hostRequirements": {
    "gpu": "optional"
  },
  "containerEnv": {
    "CMAKE_GENERATOR": "Ninja"
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/GCXX",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "anthropic.claude-code",
        "OpenAI.chatgpt",
        "NVIDIA.nsight-vscode-edition",
        "ms-vscode.makefile-tools",
        "jeff-hykin.better-cpp-syntax",
        "cschlosser.doxdocgen",
        "xaver.clang-format",
        "naela.comment-banners"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/g++-13",
        "cmake.configureOnOpen": false,
        "cmake.useCMakePresets": "always",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true
      }
    }
  }
}