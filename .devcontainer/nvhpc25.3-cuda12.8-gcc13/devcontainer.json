{
  "name": "GCXX NVHPC 25.3 CUDA 12.8 (GCC 13)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".",
    "args": {
      "BASE_IMAGE": "nvcr.io/nvidia/nvhpc:25.3-devel-cuda12.8-ubuntu24.04",
      "GCC_VERSION": "13",
      "CONTAINER_NAME": "gcxx-cuda12.8-gcc13"
    }
  },
  "runArgs": [
    "--init",
    "--name",
    "nvhpc-25.3cuda12.8-devel-gcc13"
  ],
  "hostRequirements": {
    "gpu": "optional"
  },
  "containerEnv": {
    "CMAKE_GENERATOR": "Ninja"
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/GCXX",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "NVIDIA.nsight-vscode-edition",
        "ms-vscode.makefile-tools",
        "jeff-hykin.better-cpp-syntax",
        "cschlosser.doxdocgen",
        "xaver.clang-format",
        "naela.comment-banners"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/g++-13",
        "cmake.configureOnOpen": false,
        "cmake.useCMakePresets": "always",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true
      }
    }
  }
}