{
  "name": "GCXX CUDA 13.3.0 Devel (GCC 13)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".",
    "args": {
      "BASE_IMAGE": "nvcr.io/nvidia/cuda:13.3.0-devel-ubuntu24.04",
      "GCC_VERSION": "13",
      "CONTAINER_NAME": "gcxx-cuda13.2.1-devel-gcc13"
    }
  },
  "mounts": [
    "source=${localEnv:HOME},target=/host-home,type=bind"
  ],
  "runArgs": [
    "--init",
    "--name",
    "cuda13.2.1-devel-gcc13"
  ],
  "hostRequirements": {
    "gpu": "optional"
  },
  "containerEnv": {
    "CMAKE_GENERATOR": "Ninja"
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/GCXX",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "NVIDIA.nsight-vscode-edition",
        "ms-vscode.makefile-tools",
        "jeff-hykin.better-cpp-syntax",
        "cschlosser.doxdocgen",
        "xaver.clang-format",
        "naela.comment-banners"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/g++-13",
        "cmake.configureOnOpen": false,
        "cmake.useCMakePresets": "always",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true
      }
    }
  }
}